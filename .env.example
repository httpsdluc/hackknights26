GEMINI_API_KEY=
# true for the live demo: replays server/cache/*.json, no Gemini call (same numbers)
USE_CACHED_LLM=false
SOLANA_RPC_URL=https://api.devnet.solana.com
PORT=3001
# web/ reads no settings from this file (Next.js only loads env files inside web/).
# It proxies /api to the server at API_URL (default http://localhost:3001).
# For the in-browser mocks instead: npm run dev:mocks -w web
